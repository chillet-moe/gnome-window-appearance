+static void
+get_window_shadow_params (MetaWindowActorWayland *self,
+                          gboolean                appears_focused,
+                          MetaShadowParams       *params)
+{
+  meta_shadow_factory_get_params (self->shadow_factory,
+                                  "window-appearance",
+                                  appears_focused,
+                                  params);
+}
+
+static void
+get_window_shadow_bounds (MetaWindowActorWayland *self,
+                          gboolean                appears_focused,
+                          MetaShadow             *shadow,
+                          MtkRectangle           *bounds)
+{
+  MetaShadowParams params;
+
+  get_window_shadow_params (self, appears_focused, &params);
+  meta_shadow_get_bounds (shadow,
+                          params.x_offset + self->frame_bounds.x,
+                          params.y_offset + self->frame_bounds.y,
+                          self->frame_bounds.width,
+                          self->frame_bounds.height,
+                          bounds);
+}
+
+static void
+meta_window_actor_wayland_paint (ClutterActor        *actor,
+                                 ClutterPaintContext *paint_context)
+{
+  MetaWindowActorWayland *self = META_WINDOW_ACTOR_WAYLAND (actor);
+  MetaWindow *window =
+    meta_window_actor_get_meta_window (META_WINDOW_ACTOR (self));
+  gboolean appears_focused;
+  MetaShadow *shadow;
+
+  sync_surface_tree_clip (self);
+  appears_focused = meta_window_appears_focused (window);
+  shadow = ensure_window_shadow (self, appears_focused);
+
+  if (shadow)
+    {
+      MetaShadowParams params;
+      MtkRectangle shadow_bounds;
+      g_autoptr (MtkRegion) clip = NULL;
+      CoglFramebuffer *framebuffer;
+
+      get_window_shadow_params (self, appears_focused, &params);
+      get_window_shadow_bounds (self, appears_focused, shadow,
+                                &shadow_bounds);
+      clip = mtk_region_create_rectangle (&shadow_bounds);
+      mtk_region_subtract (clip, self->rounded_frame_region);
+
+      framebuffer = clutter_paint_context_get_framebuffer (paint_context);
+      meta_shadow_paint (shadow,
+                         framebuffer,
+                         params.x_offset + self->frame_bounds.x,
+                         params.y_offset + self->frame_bounds.y,
+                         self->frame_bounds.width,
+                         self->frame_bounds.height,
+                         (clutter_actor_get_paint_opacity (actor) *
+                          params.opacity * window->opacity) / (255 * 255),
+                         clip,
+                         TRUE);
+    }
+
+  CLUTTER_ACTOR_CLASS (meta_window_actor_wayland_parent_class)->paint (
+    actor, paint_context);
+}
+
+static gboolean
+meta_window_actor_wayland_get_paint_volume (ClutterActor       *actor,
+                                            ClutterPaintVolume *volume)
+{
+  MetaWindowActorWayland *self = META_WINDOW_ACTOR_WAYLAND (actor);
+  MetaWindow *window =
+    meta_window_actor_get_meta_window (META_WINDOW_ACTOR (self));
+  gboolean appears_focused;
+  MetaShadow *shadow;
+  ClutterActor *child;
+  ClutterActorIter iter;
+
+  sync_surface_tree_clip (self);
+  appears_focused = meta_window_appears_focused (window);
+  shadow = ensure_window_shadow (self, appears_focused);
+  if (shadow)
+    {
+      MtkRectangle shadow_bounds;
+      ClutterActorBox shadow_box;
+
+      get_window_shadow_bounds (self, appears_focused, shadow,
+                                &shadow_bounds);
+      shadow_box = (ClutterActorBox) {
+        .x1 = shadow_bounds.x,
+        .y1 = shadow_bounds.y,
+        .x2 = shadow_bounds.x + shadow_bounds.width,
+        .y2 = shadow_bounds.y + shadow_bounds.height,
+      };
+      clutter_paint_volume_union_box (volume, &shadow_box);
+    }
+
+  clutter_actor_iter_init (&iter, actor);
+  while (clutter_actor_iter_next (&iter, &child))
+    {
+      g_autoptr (ClutterPaintVolume) child_volume = NULL;
+
+      if (!clutter_actor_is_mapped (child))
+        continue;
+
+      child_volume = clutter_actor_get_transformed_paint_volume (child, actor);
+      if (!child_volume)
+        return FALSE;
+
+      clutter_paint_volume_union (volume, child_volume);
+    }
+
+  return TRUE;
+}
