+static MtkRegion *
+create_rounded_rectangle_region (int width,
+                                 int height,
+                                 int radius)
+{
+  MtkRegion *region = mtk_region_create ();
+
+  radius = CLAMP (radius, 0, MIN (width, height) / 2);
+  for (int y = 0; y < height; y++)
+    {
+      float distance_from_center = 0.0f;
+      int inset = 0;
+
+      if (y < radius)
+        distance_from_center = radius - y - 0.5f;
+      else if (y >= height - radius)
+        distance_from_center = y + 0.5f - (height - radius);
+
+      if (distance_from_center > 0.0f)
+        {
+          inset = (int) ceilf (radius -
+                               sqrtf (radius * radius -
+                                      distance_from_center *
+                                      distance_from_center));
+        }
+
+      if (width > 2 * inset)
+        {
+          mtk_region_union_rectangle (
+            region,
+            &MTK_RECTANGLE_INIT (inset, y, width - 2 * inset, 1));
+        }
+    }
+
+  return region;
+}
+
+static void
+clear_window_shadows (MetaWindowActorWayland *self)
+{
+  g_clear_pointer (&self->focused_shadow, meta_shadow_unref);
+  g_clear_pointer (&self->unfocused_shadow, meta_shadow_unref);
+}
+
+static void
+sync_shadow_geometry (MetaWindowActorWayland *self,
+                      const MtkRectangle     *frame_bounds)
+{
+  g_autoptr (MtkRegion) shape_region = NULL;
+
+  if (self->rounded_frame_region &&
+      mtk_rectangle_equal (&self->frame_bounds, frame_bounds))
+    return;
+
+  clear_window_shadows (self);
+  g_clear_pointer (&self->shadow_shape, meta_window_shape_unref);
+  g_clear_pointer (&self->rounded_frame_region, mtk_region_unref);
+
+  self->frame_bounds = *frame_bounds;
+  shape_region = create_rounded_rectangle_region (frame_bounds->width,
+                                                   frame_bounds->height,
+                                                   16);
+  self->shadow_shape = meta_window_shape_new (shape_region);
+
+  self->rounded_frame_region = g_steal_pointer (&shape_region);
+  mtk_region_translate (self->rounded_frame_region,
+                        frame_bounds->x, frame_bounds->y);
+}
+
+static MetaShadow *
+ensure_window_shadow (MetaWindowActorWayland *self,
+                      gboolean                appears_focused)
+{
+  MetaShadow **shadow = appears_focused
+    ? &self->focused_shadow
+    : &self->unfocused_shadow;
+
+  if (!self->shadow_shape)
+    return NULL;
+
+  if (!*shadow)
+    {
+      ClutterContext *clutter_context =
+        clutter_actor_get_context (CLUTTER_ACTOR (self));
+      ClutterBackend *clutter_backend =
+        clutter_context_get_backend (clutter_context);
+      CoglContext *cogl_context =
+        clutter_backend_get_cogl_context (clutter_backend);
+
+      *shadow = meta_shadow_factory_get_shadow (self->shadow_factory,
+                                                self->shadow_shape,
+                                                self->frame_bounds.width,
+                                                self->frame_bounds.height,
+                                                "window-appearance",
+                                                appears_focused,
+                                                cogl_context);
+    }
+
+  return *shadow;
+}
+
+static void
+disable_window_appearance (MetaWindowActorWayland *self)
+{
+  ClutterActor *surface_container = CLUTTER_ACTOR (self->surface_container);
+  ClutterActor *child;
+  ClutterActorIter iter;
+
+  clutter_actor_remove_clip (surface_container);
+  clear_window_shadows (self);
+  g_clear_pointer (&self->shadow_shape, meta_window_shape_unref);
+  g_clear_pointer (&self->rounded_frame_region, mtk_region_unref);
+
+  clutter_actor_iter_init (&iter, surface_container);
+  while (clutter_actor_iter_next (&iter, &child))
+    {
+      MetaShapedTexture *texture =
+        meta_surface_actor_get_texture (META_SURFACE_ACTOR (child));
+
+      meta_shaped_texture_set_rounded_clip (texture, NULL, 0.0f);
+    }
+}
